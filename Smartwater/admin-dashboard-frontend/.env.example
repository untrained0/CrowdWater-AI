# Copy to .env.local (git-ignored).
# Admin passwords are bcrypt hashes. Generate one with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
# Next.js expands $ in env files, so escape every $ in the hash as \$.
ADMIN_1_USERNAME=
ADMIN_1_PASSWORD_HASH=
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD_HASH=

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
